# Bu dosyayı .env.local olarak kopyala ve doldur (gridbase init kendisi yazar).
# GridBase sunucusu (sonunda /api/gridbase YOK):
VITE_GRIDBASE_URL=https://api.gridbasetr.com
# Projenin anon key'i: panel › API anahtarları › Anon (gb_pk_…). Secret key (gb_sk_…) ASLA buraya yazılmaz.
VITE_GRIDBASE_ANON_KEY=
# İsteğe bağlı: Google ile giriş (Web client id). Aynı id panelde Proje ayarları › Google ile giriş'e de girilir.
VITE_GOOGLE_CLIENT_ID=
